{
  "name": "concreteflow-quantity-kit",
  "version": "0.1.0",
  "description": "Exact dependency-free decimal-string batch quantity calculations, without equipment control",
  "type": "module",
  "private": false,
  "engines": {
    "node": ">=20"
  },
  "main": "./src/index.mjs",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.mjs"
    }
  },
  "files": [
    "src/",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "test": "node --test",
    "audit:release": "node scripts/release-audit.mjs",
    "check": "npm run test && npm run audit:release"
  },
  "keywords": [
    "decimal", "bigint", "quantities", "concrete", "batching", "units"
  ],
  "license": "MIT"
}
